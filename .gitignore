# Operation-planning local vendor/runtime download; provenance and fetch script
# are versioned, while the pinned checkout and extracted binary cache stay local.
/operation_planning/vendor/project1-boptest/
/operation_planning/runtime/boptest_linux/*.deb
/operation_planning/workbench.log
/operation_planning/workbench.pid
/operation_planning/request.json
# External public-data download is reproducible from the tracked fetch script;
# only the six-date CC-BY subset used by the workbench is versioned.
/operation_planning/protocol/oedi910.zip
/operation_planning/protocol/oedi910_extract/
/operation_planning/protocol/gd_tariff_*.jpg
/operation_planning/results/physical_cache/
/operation_planning/results/runs/*.json
/operation_planning/data/external/oedi910.zip
/operation_planning/data/external/oedi910_extract/
